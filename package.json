{
	"name": "show-whitespace-characters",
	"version": "1.0.0",
	"description": "Display invisible whitespace characters in Obsidian editor",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": ["obsidian", "whitespace", "editor", "formatting-marks"],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.4.1",
		"@codemirror/view": "^6.26.3",
		"@types/node": "^20.12.7",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"tslib": "2.6.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"@eslint/js": "9.30.1",
		"jiti": "2.6.1"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
